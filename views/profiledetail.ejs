                <script>
                  let selectedCallUrl = null;
                  let selectedCallType = null;

                  let selectedReceiverId = null;
let selectedReceiverPhone = null;

                  function openPlanModal(callUrl, callType) {
                    selectedCallUrl = callUrl;
                    selectedCallType = callType;

                    const modal = document.getElementById("planModal");
                    const buttons = modal.querySelectorAll("button[data-plan]");

                    buttons.forEach(btn => {
                      const minutes = parseInt(btn.dataset.minutes);

                      if (callType === "voice") {
                        if (minutes === 5) btn.textContent = "5 Minutes (10 Tokens)";
                        if (minutes === 10) btn.textContent = "10 Minutes (17 Tokens)";
                        if (minutes === 20) btn.textContent = "20 Minutes (30 Tokens)";
                      } else if (callType === "video") {
                        if (minutes === 5) btn.textContent = "5 Minutes (25 Tokens)";
                        if (minutes === 10) btn.textContent = "10 Minutes (40 Tokens)";
                        if (minutes === 20) btn.textContent = "20 Minutes (70 Tokens)";
                      } else {
                        if (minutes === 5) btn.textContent = "5 Minutes (2 Tokens)";
                        if (minutes === 10) btn.textContent = "10 Minutes (4 Tokens)";
                        if (minutes === 20) btn.textContent = "20 Minutes (7 Tokens)";
                      }
                    });

                    modal.classList.remove("hidden");
                  }


                  function closePlanModal() {
                    document.getElementById("planModal").classList.add("hidden");
                  }

                  async function startPaidCall(minutes) {

                    let tokensRequired = 0;

                    if (selectedCallType === "voice") {
                      if (minutes === 5) tokensRequired = 10;
                      if (minutes === 10) tokensRequired = 17;
                      if (minutes === 20) tokensRequired = 30;

                    } else if (selectedCallType === "video") {
                      if (minutes === 5) tokensRequired = 25;
                      if (minutes === 10) tokensRequired = 40;
                      if (minutes === 20) tokensRequired = 70;

                    }

                    try {
                      const res = await fetch("/api/call/deduct-tokens", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ tokens: tokensRequired })
                      });

                      const data = await res.json();

                      if (!data.success) {
                        alert("❌ Not enough tokens");
                        return;
                      }
                      if (!selectedReceiverPhone || !selectedReceiverId) {
  alert("Something went wrong. Please try again.");
  return;
}

                      // 🔔 SEND SOCKET CALL AFTER CONFIRM
socket.emit("incoming_call", {
  to: selectedReceiverPhone,
  from: "<%= user?.phone || '' %>",
  callerName: "<%= user?.fullname || '' %>",
  callUrl: selectedCallUrl,
  type: selectedCallType
});

// 📩 SEND MESSAGE AFTER CONFIRM
await fetch("/api/messages/send", {
  method: "POST",
  headers: { "Content-Type": "application/json" },
  body: JSON.stringify({
    receiverId: selectedReceiverId,
    message:
      selectedCallType === "video"
        ? `📹 Incoming video call. Click to join: ${selectedCallUrl}`
        : `📞 Incoming voice call. Click to join: ${selectedCallUrl}`
  })
});

                      // SUCCESS → redirect to call page
                      window.location.href = selectedCallUrl + "?duration=" + minutes;

                    } catch (err) {
                      console.error("Call error:", err);
                      alert("Something went wrong starting the call");
                    }
                  }


                </script>

